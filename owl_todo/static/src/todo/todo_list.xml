<templates>
    <t t-name="owl_todo.TodoList">
        <ul class="list-group">
            <t t-foreach="store.todos" t-as="todo" t-key="todo.id">
                <li class="list-group-item d-flex align-item-center gap-2">
                    <input type="checkbox" class="form-check-input"
                        t-att-checked="todo.isCompleted"
                        t-on-click="() => this.onCheckboxClicked(todo.id)"/>

                    <span class="flex-grow-1" t-att-class="todo.isCompleted ? 'text-decoration-line-through' : ''">
                        <t t-out="todo.title"/>
                    </span>

                    <button class="btn btn-danger fa fa-trash cursor-pointer" t-on-click="() => this.onClickDeleteBtn(todo.id)"/>
                </li>
            </t>
        </ul>
    </t>
</templates>