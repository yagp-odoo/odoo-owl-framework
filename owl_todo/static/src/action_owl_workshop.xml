<templates>
    <t t-name="owl_todo.ActionOwlWorkshop">
        <ControlPanel>
            <t t-set-slot="layout-actions">
                <t t-foreach="apps" t-as="app" t-key="app.id">
                    <button type="button" t-on-click="() => this.selectApp(app.id)"
                        t-att-class="state.currentApp.id === app.id ? 'btn btn-success' : 'btn btn-secondary'">
                        <t t-out="app.name"/>
                    </button>
                </t>
            </t>
            <t t-set-slot="control-panel-navigation-additional">Switch View</t>
        </ControlPanel>
        <t t-component="state.currentApp.component" t-key="state.currentApp.id"/>
    </t>
</templates>